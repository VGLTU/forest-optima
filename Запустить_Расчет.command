#!/bin/bash
# Переход в директорию скрипта
cd "$(dirname "$0")"

echo "=================================================================="
echo " ЗАПУСК ПРОГРАММНОГО КОМПЛЕКСА 'ЛЕС-ОПТИМА' v1.0 (ВГЛТУ)"
echo "=================================================================="
echo ""

# Проверяем наличие Python
if command -v python3 &>/dev/null; then
    PY_BIN="python3"
elif command -v python &>/dev/null; then
    PY_BIN="python"
else
    echo "Ошибка: Python не найден в системе."
    exit 1
fi

# Запуск программы
$PY_BIN forest_optima.py

echo ""
echo "=================================================================="
echo " Открываю итоговый отчет..."
echo "=================================================================="

# Открытие файла в Excel или Numbers на Mac
if [ -f "Результаты_Оценки_ЛесОптима.xlsx" ]; then
    open "Результаты_Оценки_ЛесОптима.xlsx"
elif [ -f "Результаты_Оценки_ЛесОптима.csv" ]; then
    open "Результаты_Оценки_ЛесОптима.csv"
fi

echo ""
echo "Готово! Нажмите Enter для выхода..."
read
